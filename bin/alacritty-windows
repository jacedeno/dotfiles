#!/usr/bin/env bash
# alacritty-windows: on a WSL machine, write the native Windows Alacritty config
# (%APPDATA%\alacritty\alacritty.toml) from alacritty/alacritty.toml, so Windows
# gets the same theme, font, keys and herdr as the Linux desktops.
#
# Only [terminal.shell] changes: Windows Alacritty cannot exec a Linux binary, so
# it starts this WSL distro and runs herdr inside it. SHELL is exported on the way
# in because herdr spawns $SHELL for its panes and falls back to /bin/sh when it is
# unset, which it is under `wsl.exe -e`.
#
# Run by install.sh when Windows Alacritty is installed, and safe to run by hand
# after installing Alacritty later. Regenerates the file each time; a file it did
# not write is moved aside first.
set -euo pipefail

grep -qi microsoft /proc/version 2>/dev/null || { echo "alacritty-windows: not WSL, nothing to do" >&2; exit 0; }
distro=${WSL_DISTRO_NAME:-}
[ -n "$distro" ] || { echo "alacritty-windows: WSL_DISTRO_NAME is not set" >&2; exit 1; }

src="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/alacritty/alacritty.toml"
appdata=$(cmd.exe /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r')
[ -n "$appdata" ] || { echo "alacritty-windows: could not read %APPDATA%" >&2; exit 1; }
dst="$(wslpath "$appdata")/alacritty/alacritty.toml"
marker="# Generated by dotfiles/bin/alacritty-windows"
zsh_path=$(command -v zsh || echo /bin/sh)

mkdir -p "$(dirname "$dst")"
if [ -f "$dst" ] && ! grep -qF "$marker" "$dst"; then
  mv "$dst" "$dst.bak-$(date +%Y%m%d-%H%M%S)"
  echo "alacritty-windows: moved the existing config aside ($dst.bak-*)"
fi

{
  echo "$marker from alacritty/alacritty.toml."
  echo "# Do not edit here: edit the Linux file in dotfiles and run alacritty-windows."
  echo
  awk -v distro="$distro" -v zsh="$zsh_path" '
    /^\[terminal\.shell\]/ {
      print
      print "program = \"wsl.exe\""
      printf "args = [\"-d\", \"%s\", \"--cd\", \"~\", \"-e\", \"sh\", \"-lc\", %c", distro, 39
      printf "export SHELL=%s; exec \"$HOME/.local/bin/herdr\"%c]\n", zsh, 39
      skip = 1; next
    }
    skip && (/^\[/ || /^[[:space:]]*$/) { skip = 0 }
    skip { next }
    { print }
  ' "$src"
} > "$dst.part"
mv "$dst.part" "$dst"
echo "alacritty-windows: wrote $dst (distro $distro)"
