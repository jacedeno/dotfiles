#!/usr/bin/env bash
# meeting-light — meeting preset for C2-B5's Litra Beam + eMeet C960.
#
#   meeting-light        light on at 150 lm / 4500 K, camera white balance locked to match,
#                        OBS running with its virtual camera on (pick "OBS Virtual Camera" in Teams)
#   meeting-light off    light off, camera back to auto white balance, OBS closed
#
# OBS (Flatpak, profile/scene collection "Desk") feeds the eMeet through its colour and
# sharpness filters into v4l2loopback /dev/video10. A running OBS without the virtual camera is
# restarted with --startvirtualcam, but never while it is recording.
#
# 150 lm / 4500 K was picked by Jose on 2026-11-24 for a dim office: the Litra is the main
# light, 4500 K is easier on the eyes than 5000 K. Camera settings are lost on replug/reboot,
# so run this again after either.
set -euo pipefail

LUMENS=150
KELVIN=4500
LITRA="$HOME/.local/bin/litra"
CAM=/dev/v4l/by-id/usb-SHENZHEN_EMEET_TECHNOLOGY_CO._LTD._HD_Webcam_eMeet_C960_Ucamera002-video-index0

VCAM=/dev/video10
OBS_LOGS="$HOME/.var/app/com.obsproject.Studio/config/obs-studio/logs"

obs_recording() {
  local log
  log=$(ls -t "$OBS_LOGS"/* 2>/dev/null | head -1) || return 1
  [[ -n $log ]] || return 1
  (( $(grep -c "==== Recording Start" "$log") > $(grep -c "==== Recording Stop" "$log") ))
}

obs_stop() {
  pgrep -x obs >/dev/null || return 0
  if obs_recording; then
    echo "OBS is recording; leaving it alone." >&2
    return 1
  fi
  pkill -TERM -x obs
  for _ in $(seq 1 15); do pgrep -x obs >/dev/null || return 0; sleep 1; done
  echo "OBS did not close within 15 s." >&2
  return 1
}

obs_vcam_on() {
  if pgrep -x obs >/dev/null; then
    if fuser "$VCAM" 2>/dev/null | grep -q "$(pgrep -x obs)"; then
      echo "OBS: already running with the virtual camera on"
      return 0
    fi
    obs_stop || return 1
  fi
  systemd-run --user --collect --quiet flatpak run com.obsproject.Studio --startvirtualcam
  for _ in $(seq 1 20); do
    if pgrep -x obs >/dev/null && fuser "$VCAM" >/dev/null 2>&1; then
      echo "OBS: virtual camera on ($VCAM) — pick \"OBS Virtual Camera\" in Teams"
      return 0
    fi
    sleep 1
  done
  echo "OBS started but the virtual camera is not up yet; check OBS." >&2
  return 1
}

cam_ok() {
  if [[ ! -e $CAM ]]; then
    echo "eMeet C960 has no video node. If lsusb still lists 328f:2013, its firmware hung at" >&2
    echo "boot (uvcvideo -110 timeouts): unplug it, wait 5 s, plug it back, run this again." >&2
    return 1
  fi
}

if [[ ${1:-on} == off ]]; then
  "$LITRA" off
  obs_stop && echo "OBS closed."
  cam_ok && v4l2-ctl -d "$CAM" -c white_balance_automatic=1
  echo "Litra off, camera white balance back to auto."
  exit 0
fi

"$LITRA" on
"$LITRA" brightness --value "$LUMENS"
"$LITRA" temperature --value "$KELVIN"
echo "Litra: ${LUMENS} lm, ${KELVIN} K"

cam_ok || exit 1
# The C960 exposes white balance in tens of Kelvin (300-600) and has no manual exposure.
v4l2-ctl -d "$CAM" -c white_balance_automatic=0
v4l2-ctl -d "$CAM" -c white_balance_temperature=$((KELVIN / 10)),backlight_compensation=0,sharpness=63,power_line_frequency=2
echo "eMeet: white balance locked at ${KELVIN} K, backlight compensation off, sharpness 63, 60 Hz"

obs_vcam_on
