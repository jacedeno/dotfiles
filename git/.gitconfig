[user]
	name = jacedeno
	email = jacedeno@geekendzone.com
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[core]
	# Global hooks: dotfiles/git/hooks (commit-msg rejects AI attribution).
	# Linked to ~/.config/git/hooks by install.sh; ~ works cross-platform.
	hooksPath = ~/.config/git/hooks
[alias]
	st = status
	lg = log --oneline --graph --all
	s = status -sb
[pull]
	rebase = true

# Machine-specific overrides (identity, credential helper paths). Must stay the
# LAST section: git applies settings in file order, so anything after it would win
# over the local file (core.hooksPath did, until 2026-10-18). Not tracked — same pattern as ~/.zshrc.local.
[include]
	path = ~/.gitconfig.local
