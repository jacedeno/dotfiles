[user]
	name = jacedeno
	email = jacedeno@geekendzone.com
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
# Machine-specific overrides (identity, credential helper paths). Loaded last,
# so values here win. Not tracked — same pattern as ~/.zshrc.local.
[include]
	path = ~/.gitconfig.local
[core]
	# Global hooks: dotfiles/git/hooks (commit-msg rejects AI attribution).
	# Linked to ~/.config/git/hooks by install.sh; ~ works cross-platform.
	hooksPath = ~/.config/git/hooks
